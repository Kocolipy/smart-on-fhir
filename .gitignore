# Monorepo-wide ignore rules.

# Environment
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS / editor
.DS_Store
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
**/.vscode/*
!**/.vscode/extensions.json

# Build output and dependencies
node_modules/
dist-ssr/
target/
coverage/
.nyc_output/
test-results/
playwright-report/
.stryker-tmp/
*.local
*.tsbuildinfo
# Surefire's runOrder=balanced timings, per machine (see backend/pom.xml).
/backend/.surefire-*

# AI tooling: agent definitions are tracked, fetched skills are not.
**/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/mutation-testing/
**/.claude/skills/*
**/.codex/skills/*
**/.kiro/skills/*
**/.kiro/settings/*
**/.scratch/*
**/artifacts/*
skills-lock.json

# graphify knowledge-graph output: the committed graph is kept, the
# regenerable cache and dated run directories are not.
**/graphify-out/cost.json
**/graphify-out/cache/
**/graphify-out/.graphify_python
**/graphify-out/.graphify_root
**/graphify-out/.graphify_refresh.log
**/graphify-out/.graphify_refresh.lock
**/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
**/graphify-out/reflections/*

frontend/dist/
frontend/playwright/.cache/
frontend/test/e2e/.auth/

/backend/frontend/
backend/cookies.txt

# infra/: deploy artefacts and secrets the CloudFormation scripts write locally
/infra/parameters.json
/infra/*-outputs.txt
/infra/*.pem

# Scratch
TODO

