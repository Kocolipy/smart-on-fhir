<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>backend</name>
    <description>Spring Boot backend with Redis-backed HTTP sessions</description>

    <properties>
        <java.version>25</java.version>
        <pitest.version>1.30.0</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <enforcer.version>3.5.0</enforcer.version>
        <resources-plugin.version>3.3.1</resources-plugin.version>
        <!-- Test JVMs; see maven-surefire-plugin below. -->
        <forkCount>2</forkCount>
        <!--
          Where the built SPA is read from by the `with-frontend` profile. No
          generated output is committed anywhere in the tree, and nothing is
          copied back into a source directory: the profile reads this directory
          and writes only into target/classes/static.

          The default points at the sibling app so `mvn -Pwith-frontend package`
          works from backend/ on its own. It is the only parent-relative path in
          this POM, it is inert unless the profile is active — the default build
          has no frontend dependency at all — and the root build step overrides
          it explicitly, so it never has to be trusted for a release.
        -->
        <frontend.dist.dir>${project.basedir}/../frontend/dist</frontend.dist.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Epic SMART on FHIR EHR launch Login (/docs/adr/0013-epic-login.md). Inert until a
             later step configures oauth2Login: no client registration is declared, so Boot's
             OAuth2 client auto-configuration contributes no repository and no filter chain. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <!-- Spring Boot's auto-configured RestClient.Builder, which epicRestClient is built
             from (D25) so every Epic call carries the shared observation (http.client.requests,
             a client span) and the converters Boot configures. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          Spring Boot 4 split autoconfiguration into feature-specific modules:
          flyway-core alone no longer triggers FlywayAutoConfiguration or the
          JPA-after-Flyway ordering, so Flyway silently never ran and Hibernate's
          ddl-auto: validate failed against an empty schema. This starter is what
          actually wires FlywayAutoConfiguration; flyway-database-postgresql adds
          the PostgreSQL-specific migration support the starter does not include
          on its own.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          The operational-telemetry exporter: Actuator's /actuator/prometheus scrape
          endpoint exists only when this registry is on the classpath. Version comes
          from the Micrometer BOM that Spring Boot manages, so it moves with Boot.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
          Log correlation: the OpenTelemetry bridge gives every observation — each
          HTTP request, each scheduled-job run — a span, and its trace and span ids
          reach the logging context as `trace.id` / `span.id`. The Boot module is
          what wires the bridge in Boot 4; the bridge is declared as well so the
          dependency the logging standard names is visible here.

          Correlation only. No exporter is on the classpath and export is switched
          off in `telemetry.yaml`, so a span never leaves the host; the ids exist
          whether or not anything exports them. Do not add
          `spring-boot-starter-opentelemetry`: it brings the OTLP exporters.
          Versions come from Boot's dependency management.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!--
          Spring Security's Argon2PasswordEncoder delegates to BouncyCastle for
          the actual Argon2 primitive; it is not transitively pulled in by
          spring-security-crypto, so it has to be declared explicitly.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Test contexts disable metrics export by default; @AutoConfigureMetrics,
          which lives here in Boot 4, turns the Prometheus scrape back on for the
          telemetry tests that read it.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-metrics-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!--
              `logging.yaml` alone is filtered, so `@project.version@` in it becomes
              the built version and every log record's `service.version` names the
              artefact that wrote it. Nothing else is: filtering rewrites any
              `@...@` it meets, and no other resource has asked for that.
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>logging.yaml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>logging.yaml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!--
              Toolchain gate. Both rules are about reproducibility, not taste: the
              code targets Java 25 language features, and the build is only
              reproducible on the Maven the wrapper pins. This runs in `validate`,
              so a wrong JDK or a stray older Maven fails in seconds rather than
              in a confusing compile or plugin error minutes later.

              Keep requireMavenVersion's floor in lockstep with the version in
              .mvn/wrapper/maven-wrapper.properties and /.tool-versions.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer.version}</version>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <!-- Exactly the 25 line: 24 cannot compile it, 26 is untested here. -->
                                    <version>[25,26)</version>
                                    <message>
                                        This service targets Java ${java.version}. Point JAVA_HOME at a
                                        JDK 25 (see /.tool-versions) and build through ./mvnw.
                                    </message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.11,)</version>
                                    <message>
                                        Maven 3.9.11 or newer is required. Build through ./mvnw, which
                                        downloads and verifies exactly the pinned distribution, instead
                                        of whatever `mvn` resolves to on this machine.
                                    </message>
                                </requireMavenVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              Two test JVMs, each running its share of the test classes. Measured on a
              20-core machine with a 5.9 GB WSL VM: 217s with one JVM, ~143s with two,
              124s with three. Two, not more: the third JVM saves ~20s but peaks within
              ~0.8 GB of the VM's memory, and "1C" would start a JVM per core. A fork
              starts its own Postgres and Redis (ContainerTestConfiguration), so contexts
              split across forks cost a migrated database each, not a container start.
              Override with -DforkCount=1 to debug a test in one JVM.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <forkCount>${forkCount}</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.example.backend.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.example.backend.*</param>
                    </targetTests>
                    <excludedTestClasses>
                        <param>arch.*</param>
                    </excludedTestClasses>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Integrated build: frontend source -> frontend/dist ->
          backend/target/classes/static -> executable JAR.

          Off by default, so `mvn clean verify` in backend/ stays a pure backend
          build with no frontend toolchain and no SPA in the JAR. Activate it for
          a release: `make package` (root) or
          `mvn -Pwith-frontend -Dfrontend.dist.dir=<abs path> package`.

          The enforcer step runs in `validate`, before resources are copied, so a
          missing or half-built frontend fails the build instead of quietly
          packaging whatever happened to be on disk. There is nothing stale to
          package either — target/ is not tracked, and no build output lives in a
          source directory.
        -->
        <profile>
            <id>with-frontend</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${enforcer.version}</version>
                        <executions>
                            <execution>
                                <id>require-frontend-build</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireFilesExist>
                                            <files>
                                                <file>${frontend.dist.dir}/index.html</file>
                                            </files>
                                            <message>
                                                No frontend build found at ${frontend.dist.dir}. The
                                                with-frontend profile packages the SPA from that
                                                directory and refuses to package a stale or absent
                                                one. Build it first (`npm run build` in frontend/),
                                                or run `make package` from the repository root,
                                                which builds the SPA and then invokes this profile.
                                            </message>
                                        </requireFilesExist>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>${resources-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>copy-frontend-dist</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <overwrite>true</overwrite>
                                    <resources>
                                        <resource>
                                            <directory>${frontend.dist.dir}</directory>
                                            <!--
                                              Never filter: the build emits .br and .gz
                                              siblings, and Maven filtering corrupts binary
                                              files it rewrites.
                                            -->
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
