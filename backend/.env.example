SERVER_PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_TIMEOUT=15m
SESSION_COOKIE_SECURE=false
APP_BOOTSTRAP_USERNAME=admin
APP_BOOTSTRAP_PASSWORD=P@ssw0rd
APP_LOCKOUT_MAX_ATTEMPTS=3
# Seed the development Groups and Users the shipped role mapping names, so a
# local run and the e2e suite have a User per Role, plus `user`, a User with no
# Role. Default when unset: false, and then startup seeds only the Bootstrap
# Admin and refuses the development mapping. Never enable in a deployment.
APP_DEV_FIXTURES_ENABLED=true
# Every development fixture User's password (user, account-admin, auditor,
# connector-admin, monitoring, dormant). No fallback: required when the fixtures
# are on. With the fixtures on, the dormancy job also runs once at startup, after
# seeding has backdated the `dormant` fixture past the lockout window.
APP_DEV_FIXTURES_PASSWORD=Dev-Fixture-P@ssw0rd
APP_SESSION_ABSOLUTE_LIFETIME=8h
# How long recorded audit events are kept. Default when unset: 365d (one year).
# Floor: 90d — a shorter window fails startup rather than silently keeping less.
APP_AUDIT_RETENTION_PERIOD=365d
# When the retention job runs, as a Spring cron expression. Default: 0 30 3 * * *
APP_AUDIT_RETENTION_SCHEDULE="0 30 3 * * *"
# How long a User may go without logging in before the daily dormancy job locks
# it (lock cause DORMANCY; only an Admin's Unlock lifts it). Default when unset:
# 90d. Must be positive.
APP_DORMANCY_LOCKOUT_WINDOW=90d
# How long a User may go without logging in before the daily dormancy job
# removes its direct membership of every mapped Group. Default when unset: 180d.
# Must be positive and longer than the lockout window.
APP_DORMANCY_ROLE_REVOCATION_WINDOW=180d
# Logging. Unset LOG_FILE (the default) means stdout only; set it to also write a
# rolling ECS JSON file (deployed: /var/log/backend/backend.json).
# LOG_FILE=/var/log/backend/backend.json
# The deployment's name on every log record (service.environment). Default: local.
# APP_ENVIRONMENT=local
# Epic SMART on FHIR EHR launch Login (/docs/epic-smart-login.md). Off by default:
# with APP_EPIC_ENABLED unset or false, nothing below is read or required, and
# every /api/auth/epic/** route answers 404. There are NO default values — this
# repository is public — and with the switch on, startup fails on any required
# variable that is missing or malformed. A startup error names the variable,
# never its value. An empty value counts as unset.
APP_EPIC_ENABLED=false
# Required when enabled. The FHIR base URL: the one allowed launch `iss`, sent as
# `aud`, and the prefix of `fhirUser`. Must be https (http only in the dev profile).
# APP_EPIC_FHIR_BASE=https://fhir.example.org/api/FHIR/R4
# Required when enabled. The OIDC issuer used for discovery and the id_token
# `iss`. Must be https (http only in the dev profile).
# APP_EPIC_OAUTH_ISSUER=https://fhir.example.org/oauth2
# Required when enabled. The client id Epic registered for this application.
# APP_EPIC_CLIENT_ID=
# Required when enabled. The absolute callback URL exactly as registered with
# Epic; its path is /api/auth/epic/callback. Must be https (http only in the dev
# profile).
# APP_EPIC_REDIRECT_URI=https://app.example.org/api/auth/epic/callback
# Required when enabled. The active signing key: an EC P-384 private key in
# PKCS#8 PEM (-----BEGIN PRIVATE KEY-----), e.g. from
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-384
# It may be written on one line, with or without its line breaks escaped as \n.
# This is a PRIVATE KEY: never commit one, here or anywhere, and never log it.
# APP_EPIC_CLIENT_KEY=
# Required when enabled. The active key's `kid`, as published in our JWKS.
# APP_EPIC_CLIENT_KEY_ID=
# Optional. The next signing key (same format and the same care), published in
# the JWKS but never used to sign, and its `kid`. Set both or neither; the two
# kids must differ.
# APP_EPIC_CLIENT_NEXT_KEY=
# APP_EPIC_CLIENT_NEXT_KEY_ID=
# Optional. Timeouts for every outbound call to Epic. Default when unset: 2s
# connect, 5s read. Must be positive.
# APP_EPIC_CONNECT_TIMEOUT=2s
# APP_EPIC_READ_TIMEOUT=5s
