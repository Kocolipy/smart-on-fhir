SERVER_PORT=8080
# `local` runs the schema migrations at startup, as the owner login below. Every
# other profile leaves Flyway off: a deployment migrates beforehand, in its migrate
# step (infra/docs/database-boot.md). Add `dev` for the local Epic stand-in (local,dev).
SPRING_PROFILES_ACTIVE=local
# The database and its three logins (docs/configuration/database.md). Neither the
# URL nor any credential has a default, so each must be set. These are LOCAL
# values for the compose SQL Server; `make infra-up` creates the database and all
# three logins from them (compose.yaml's `sqlserver-init`). Never reuse them
# anywhere else. A password must hold no quote: the init refuses one.
#
# The compose SQL Server's administrator. Read by compose alone, for the server
# and its init; the backend never sees it. SQL Server's policy: at least 8
# characters, from three of upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=P@ssw0rd
# The local server's certificate is self-signed; the `local` profile trusts it
# (application.yaml), and the connection is still encrypted (database.yaml).
# Quoted: the shell that sources this file (make dev) would end the value at `;`.
DATABASE_URL="jdbc:sqlserver://localhost:1433;databaseName=backend"
# The app login: every request's pool and the audit append pool. A member of
# backend_app only.
DATABASE_USERNAME=backend_app_login
DATABASE_PASSWORD=P@ssw0rd
# The retention login: the audit retention job's own pool, and nothing else. A
# member of backend_audit_retention only.
DATABASE_RETENTION_USERNAME=backend_retention_login
DATABASE_RETENTION_PASSWORD=P@ssw0rd
# The owner login: a db_owner member that runs the migrations, read only in the
# `local` (and `migrate`) profile.
DATABASE_OWNER_USERNAME=backend_owner
DATABASE_OWNER_PASSWORD=P@ssw0rd
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_TIMEOUT=15m
SESSION_COOKIE_SECURE=false
APP_BOOTSTRAP_USERNAME=admin
# The Bootstrap Admin's first password. No fallback: startup fails without it.
APP_BOOTSTRAP_PASSWORD=P@ssw0rd
APP_LOCKOUT_MAX_ATTEMPTS=3
# Seed the development Groups and Users (authorization.yaml), so a local run and
# the e2e suite have a User per development Group, plus `user`, a User in no
# Group; under the `local` profile the Groups' Permissions are seeded too.
# Default when unset: false, and then startup seeds only the Bootstrap Admin and
# the Admin group. With it on, a newly seeded Bootstrap Admin also owes no
# first-login password change. Refused outside the `local` profile: enabled under
# any other, startup fails.
APP_DEV_FIXTURES_ENABLED=true
# Every development fixture User's password (guest, auditor, helpdesk,
# dormant). No fallback: required when the fixtures
# are on. With the fixtures on, the dormancy job also runs once at startup, after
# seeding has backdated the `dormant` fixture past the lockout window.
APP_DEV_FIXTURES_PASSWORD=P@ssw0rd
APP_SESSION_ABSOLUTE_LIFETIME=8h
# How long recorded audit events are kept. Default when unset: 365d (one year).
# Floor: 90d — a shorter window fails startup rather than silently keeping less.
APP_AUDIT_RETENTION_PERIOD=365d
# When the retention job runs, as a Spring cron expression. Default: 0 30 3 * * *
APP_AUDIT_RETENTION_SCHEDULE="0 30 3 * * *"
# The audit append pool: the small pool of its own that fail-open audit appends
# (refusals, post-commit session revocations) commit on, so they never wait for a
# main-pool connection a refusing request holds. Sizing only — it connects as the
# app login above and has no credentials of its own. Default when unset:
# 2 connections, 2s connection timeout. Size 2 or 3; timeout at least 250ms.
# APP_AUDIT_POOL_SIZE=2
# APP_AUDIT_POOL_TIMEOUT=2s
# How long a User may go without logging in before the daily dormancy job locks
# it (lock cause DORMANCY; only an Admin's Unlock lifts it). Default when unset:
# 90d. Must be positive.
APP_DORMANCY_LOCKOUT_WINDOW=90d
# How long a User may go without logging in before the daily dormancy job
# removes its direct membership of every Group (Membership revocation). Default
# when unset: 180d. Must be positive and longer than the lockout window.
APP_DORMANCY_MEMBERSHIP_REVOCATION_WINDOW=180d
# Logging. Unset LOG_FILE (the default) means stdout only; set it to also write a
# rolling ECS JSON file (deployed: /var/log/backend/backend.json).
# LOG_FILE=/var/log/backend/backend.json
# The deployment's name on every log record (service.environment). Default: local.
# APP_ENVIRONMENT=local
# Epic SMART on FHIR EHR launch Login (/docs/adr/0012-epic-login.md). Off by default:
# with APP_EPIC_ENABLED unset or false, nothing below is read or required, and
# every /api/auth/epic/** route answers 404. There are NO default values — this
# repository is public — and with the switch on, startup fails on any required
# variable that is missing or malformed. A startup error names the variable,
# never its value. An empty value counts as unset.
APP_EPIC_ENABLED=false
# Against the local Epic stand-in, Medplum, `make fhircast-up` sets everything for
# you: it keeps a managed block at the end of this file (and comments out any line
# above that sets what the block does), see docs/configuration/epic-login.md,
# "Local Epic stand-in". Nothing below needs setting by hand for it.
# Optional, and the `local` profile's alone, like the other development fixtures
# (APP_DEV_FIXTURES_ENABLED above): the userName of one more fixture User, in no
# Group, holding only the baseline Permissions. It is the local Epic stand-in's
# clinician, so it must be that clinician's Practitioner id (`SEED_CLINICIAN_ID` in
# compose.yaml), which is how Epic Login links it; `make fhircast-up` sets it.
# Default when unset or blank: none is seeded.
# APP_DEV_FIXTURES_EPIC_CLINICIAN=
# Required when enabled. The FHIR base URL: the one allowed launch `iss`, sent as
# `aud`, and the prefix of `fhirUser`. Must be https (http only in the dev profile).
# APP_EPIC_FHIR_BASE=https://fhir.example.org/api/FHIR/R4
# Required when enabled. The OIDC issuer used for discovery and the id_token
# `iss`. Must be https (http only in the dev profile).
# APP_EPIC_OAUTH_ISSUER=https://fhir.example.org/oauth2
# Required when enabled. The client id Epic registered for this application.
# APP_EPIC_CLIENT_ID=
# Required when enabled. The absolute callback URL exactly as registered with
# Epic; its path is /api/auth/epic/callback. Must be https (http only in the dev
# profile).
# APP_EPIC_REDIRECT_URI=https://app.example.org/api/auth/epic/callback
# Required when enabled. The active signing key: an EC P-384 private key in
# PKCS#8 PEM (-----BEGIN PRIVATE KEY-----), e.g. from
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-384
# It may be written on one line, with or without its line breaks escaped as \n.
# This is a PRIVATE KEY: never commit one, here or anywhere, and never log it.
# APP_EPIC_CLIENT_KEY=
# Required when enabled. The active key's `kid`, as published in our JWKS.
# APP_EPIC_CLIENT_KEY_ID=
# Optional. The next signing key (same format and the same care), published in
# the JWKS but never used to sign, and its `kid`. Set both or neither; the two
# kids must differ.
# APP_EPIC_CLIENT_NEXT_KEY=
# APP_EPIC_CLIENT_NEXT_KEY_ID=
# Optional. Timeouts for every outbound call to Epic. Default when unset: 2s
# connect, 5s read. Must be positive.
# APP_EPIC_CONNECT_TIMEOUT=2s
# APP_EPIC_READ_TIMEOUT=5s
# Optional. Whether the id_token must carry MFA evidence in `amr` (D17). Default
# when unset: false — the Epic organisation's MFA is an attestation, and every
# Epic Login's factor is recorded as `idp-attested`. Turn it on only once Epic
# confirms it sends `amr` on an EHR launch: a token whose `amr` then names no
# RFC 8176 second factor (the list is in ADR 0012) and not `mfa` is refused,
# and the factor recorded is the one `amr` named.
# APP_EPIC_MFA_EVIDENCE_REQUIRED=false
