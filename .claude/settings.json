{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat \"$CLAUDE_PROJECT_DIR/graphify-out/.graphify_python\" 2>/dev/null) && [ -x \"$i\" ] || exit 0; \"$i\" -m graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat \"$CLAUDE_PROJECT_DIR/graphify-out/.graphify_python\" 2>/dev/null) && [ -x \"$i\" ] || exit 0; \"$i\" -m graphify hook-guard read"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; npx prettier --write --ignore-unknown \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Running prettier..."
          }
        ]
      }
    ]
  }
}
