{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat \"$(git rev-parse --show-toplevel 2>/dev/null)/graphify-out/.graphify_python\" 2>/dev/null) && [ -x \"$i\" ] || exit 0; \"$i\" -m graphify hook-check"
          }
        ]
      }
    ]
  }
}
